{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/simulation_case.schema.json",
  "title": "Damage simulation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "target_ref",
    "encounter",
    "warhead",
    "environment",
    "analysis",
    "parameter_set_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "target_revision", "content_hash"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "target_revision": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "encounter": {"$ref": "#/$defs/encounter"},
    "munition": {"$ref": "#/$defs/munition"},
    "warhead": {"$ref": "#/$defs/warhead"},
    "environment": {"$ref": "#/$defs/environment"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "parameter_set_id": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "required": ["encounter"],
        "properties": {
          "encounter": {
            "required": ["detonation_trigger"],
            "properties": {"detonation_trigger": {"const": "first_armor_contact"}}
          }
        }
      },
      "then": {"required": ["munition"]}
    }
  ],
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "quaternionXyzw": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "munition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_revision",
        "display_name_zh",
        "projectile_length_m",
        "projectile_diameter_m",
        "warhead_length_m",
        "warhead_diameter_m",
        "wall_thickness_m",
        "detonation_point",
        "fuze_type",
        "trajectory_reference_point",
        "fragment_ring_count",
        "fragments_per_ring",
        "fragment_axial_coverage_ratio",
        "fragment_spread_sigma_deg",
        "tnt_equivalence",
        "reference_source_id",
        "reference_source_location",
        "validation_status"
      ],
      "properties": {
        "profile_id": {"enum": ["small_front", "medium_front", "large_front"]},
        "profile_revision": {"const": "loitering-munition-reference-port-v1"},
        "display_name_zh": {"type": "string", "minLength": 1},
        "projectile_length_m": {"type": "number", "exclusiveMinimum": 0},
        "projectile_diameter_m": {"type": "number", "exclusiveMinimum": 0},
        "warhead_length_m": {"type": "number", "exclusiveMinimum": 0},
        "warhead_diameter_m": {"type": "number", "exclusiveMinimum": 0},
        "wall_thickness_m": {"type": "number", "exclusiveMinimum": 0},
        "detonation_point": {"const": "front"},
        "fuze_type": {"const": "impact_contact"},
        "trajectory_reference_point": {"const": "nose_fuze"},
        "fragment_ring_count": {"type": "integer", "minimum": 1},
        "fragments_per_ring": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "fragment_axial_coverage_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "fragment_spread_sigma_deg": {"type": "number", "minimum": 0},
        "tnt_equivalence": {"type": "number", "exclusiveMinimum": 0},
        "reference_source_id": {"type": "string", "minLength": 1},
        "reference_source_location": {"type": "string", "minLength": 1},
        "validation_status": {"const": "unverified"}
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detonation_position_m",
        "body_to_target_orientation_xyzw",
        "velocity_target_mps"
      ],
      "properties": {
        "detonation_position_m": {"$ref": "#/$defs/vector3"},
        "body_to_target_orientation_xyzw": {"$ref": "#/$defs/quaternionXyzw"},
        "velocity_target_mps": {"$ref": "#/$defs/vector3"},
        "detonation_time_s": {"type": "number", "minimum": 0},
        "detonation_trigger": {"enum": ["preset", "first_armor_contact"]},
        "trajectory_origin_m": {"$ref": "#/$defs/vector3"},
        "trajectory_reference_point": {"const": "nose_fuze"},
        "detonation_delay_s": {"const": 0.0},
        "collision_distance_m": {"type": "number", "minimum": 0},
        "collision_armor_id": {"type": "string", "minLength": 1},
        "collision_normal_target_xyz": {"$ref": "#/$defs/vector3"},
        "impact_model_id": {"const": "continuous-ray-first-armor-v1"}
      },
      "allOf": [
        {
          "if": {
            "required": ["detonation_trigger"],
            "properties": {"detonation_trigger": {"const": "first_armor_contact"}}
          },
          "then": {
            "required": [
              "detonation_time_s",
              "trajectory_origin_m",
              "trajectory_reference_point",
              "detonation_delay_s",
              "collision_distance_m",
              "collision_armor_id",
              "collision_normal_target_xyz",
              "impact_model_id"
            ]
          }
        }
      ]
    },
    "massDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "parameters", "source_id"],
      "properties": {
        "family": {"enum": ["fixed", "lognormal", "weibull", "empirical"]},
        "parameters": {"type": "object"},
        "source_id": {"type": "string", "minLength": 1},
        "valid_range_kg": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "allOf": [
        {
          "if": {"properties": {"family": {"const": "fixed"}}, "required": ["family"]},
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value_kg"],
                "properties": {"value_kg": {"type": "number", "exclusiveMinimum": 0}}
              }
            }
          }
        },
        {
          "if": {"properties": {"family": {"const": "lognormal"}}, "required": ["family"]},
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["median_kg", "log_sigma"],
                "properties": {
                  "median_kg": {"type": "number", "exclusiveMinimum": 0},
                  "log_sigma": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"family": {"const": "weibull"}}, "required": ["family"]},
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scale_kg", "shape"],
                "properties": {
                  "scale_kg": {"type": "number", "exclusiveMinimum": 0},
                  "shape": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"family": {"const": "empirical"}}, "required": ["family"]},
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["values_kg"],
                "properties": {
                  "values_kg": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "number", "exclusiveMinimum": 0}
                  },
                  "probabilities": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "number", "minimum": 0, "maximum": 1}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "fragmentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "total_count",
        "mass_distribution",
        "shape_class",
        "density_kg_m3",
        "drag_model_id",
        "direction_model_id",
        "initial_velocity_model_id"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "total_count": {"type": "integer", "minimum": 1},
        "mass_distribution": {"$ref": "#/$defs/massDistribution"},
        "shape_class": {"enum": ["sphere", "cube", "cylinder", "irregular", "empirical"]},
        "density_kg_m3": {"type": "number", "exclusiveMinimum": 0},
        "drag_model_id": {"type": "string", "minLength": 1},
        "direction_model_id": {"type": "string", "minLength": 1},
        "initial_velocity_model_id": {"type": "string", "minLength": 1},
        "gurney_constant_mps": {"type": "number", "exclusiveMinimum": 0},
        "detonation_velocity_mps": {"type": "number", "exclusiveMinimum": 0},
        "fragment_list_ref": {"type": ["string", "null"]}
      }
    },
    "blastSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "equivalent_mass_kg",
        "equivalency_basis",
        "pressure_time_model_id",
        "source_id"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "equivalent_mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "equivalency_basis": {"type": "string", "minLength": 1},
        "pressure_time_model_id": {"const": "scaled-table"},
        "source_id": {"type": "string", "minLength": 1}
      }
    },
    "warhead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warhead_id", "revision", "fragment_source", "blast_source", "source_id"],
      "properties": {
        "warhead_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "charge_mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "casing_mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "fragment_source": {"$ref": "#/$defs/fragmentSource"},
        "blast_source": {"$ref": "#/$defs/blastSource"},
        "source_id": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["air_density_kg_m3", "ambient_pressure_pa", "temperature_k"],
      "properties": {
        "air_density_kg_m3": {"type": "number", "exclusiveMinimum": 0},
        "ambient_pressure_pa": {"type": "number", "exclusiveMinimum": 0},
        "temperature_k": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fidelity_level",
        "mechanisms",
        "aleatory_seed",
        "epistemic_sample_id",
        "replicates",
        "coupling_model",
        "evaluation_standard_ids"
      ],
      "properties": {
        "fidelity_level": {"enum": ["L0", "L1", "L2", "L3"]},
        "mechanisms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["fragment", "blast"]}
        },
        "aleatory_seed": {"type": "integer", "minimum": 0},
        "epistemic_sample_id": {"type": "string", "minLength": 1},
        "replicates": {"type": "integer", "minimum": 1},
        "adaptive_ci_half_width": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "adaptive_physical_ci": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(component\\.(fragment|blast)|armor(\\.blast)?|summary)\\.[A-Za-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "absolute_half_width": {"type": "number", "exclusiveMinimum": 0},
              "relative_half_width": {"type": "number", "exclusiveMinimum": 0},
              "relative_floor": {"type": "number", "minimum": 0, "default": 0}
            },
            "anyOf": [
              {"required": ["absolute_half_width"]},
              {"required": ["relative_half_width"]}
            ]
          }
        },
        "coupling_model": {"enum": ["none", "sequential"]},
        "capture_fragment_audit": {"type": "boolean", "default": false},
        "capture_replicate_trace": {"type": "boolean", "default": false},
        "evaluation_standard_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["adaptive_ci_half_width"],
            "properties": {"adaptive_ci_half_width": {"type": "number"}}
          },
          "then": {"properties": {"replicates": {"minimum": 32}}}
        },
        {
          "if": {"required": ["adaptive_physical_ci"]},
          "then": {"properties": {"replicates": {"minimum": 32}}}
        }
      ]
    }
  }
}

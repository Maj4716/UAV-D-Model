{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/sampling_spec.schema.json",
  "title": "Damage-engine sampling design specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sampling_spec_id", "revision", "status", "reference_distribution", "budgets", "seeds", "formal_policy", "split_policy", "quality_gates"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]},
    "model_input_contract": {
      "enum": [
        "uav_state_only@1.0.0",
        "loitering_impact_state_only@1.0.0"
      ]
    },
    "sampling_spec_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["provisional", "approved", "deprecated"]},
    "reference_distribution": {"type": "object", "additionalProperties": false, "required": ["distribution_id", "interpretation", "variables", "constraints"], "properties": {"distribution_id": {"type": "string", "minLength": 1}, "interpretation": {"enum": ["design_distribution", "operational_distribution"]}, "variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variable"}}, "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["train_pilot", "validation", "test", "rare_stress_test"], "properties": {"train_pilot": {"type": "integer", "minimum": 1}, "validation": {"type": "integer", "minimum": 1}, "test": {"type": "integer", "minimum": 1}, "rare_stress_test": {"type": "integer", "minimum": 0}}},
    "seeds": {"type": "object", "additionalProperties": false, "required": ["design", "selection", "split", "screening", "formal"], "properties": {"design": {"type": "integer", "minimum": 0}, "selection": {"type": "integer", "minimum": 0}, "split": {"type": "integer", "minimum": 0}, "screening": {"type": "integer", "minimum": 0}, "formal": {"type": "integer", "minimum": 0}}},
    "formal_policy": {"type": "object", "additionalProperties": false, "required": ["replicates", "adaptive_ci_half_width", "epistemic_policy"], "properties": {"replicates": {"type": "integer", "minimum": 2}, "adaptive_ci_half_width": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "epistemic_policy": {"const": "unique_per_lineage"}}},
    "split_policy": {"type": "object", "additionalProperties": false, "required": ["registry_id", "freeze_before_outcomes", "adaptive_train_only"], "properties": {"registry_id": {"type": "string", "minLength": 1}, "freeze_before_outcomes": {"const": true}, "adaptive_train_only": {"const": true}}},
    "quality_gates": {"type": "object", "additionalProperties": false, "required": ["positivity_min", "min_ess_fraction", "max_weight_cv"], "properties": {"positivity_min": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "min_ess_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "max_weight_cv": {"type": "number", "minimum": 0}}},
    "feature_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/featureRole"}},
    "variable_blocks": {"type": "array", "items": {"$ref": "#/$defs/variableBlock"}},
    "geometry_strata": {"type": "array", "items": {"$ref": "#/$defs/geometryStratum"}},
    "stream_roles": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/streamRole"}},
    "round_budgets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/roundBudget"}},
    "replicate_policy": {"$ref": "#/$defs/replicatePolicy"},
    "key_projections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/keyProjection"}},
    "proxy_scope": {"$ref": "#/$defs/proxyScope"},
    "legal_sampling": {"$ref": "#/$defs/legalSampling"},
    "contact_conditioning": {"$ref": "#/$defs/contactConditioning"}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"enum": ["1.1.0", "1.2.0", "1.3.0"]}}, "required": ["schema_version"]}, "then": {"required": ["feature_roles", "variable_blocks", "geometry_strata", "stream_roles", "round_budgets", "replicate_policy", "key_projections", "proxy_scope", "legal_sampling"]}},
    {"if": {"properties": {"schema_version": {"const": "1.2.0"}}, "required": ["schema_version"]}, "then": {"required": ["model_input_contract"]}},
    {"if": {"properties": {"schema_version": {"const": "1.3.0"}}, "required": ["schema_version"]}, "then": {"required": ["model_input_contract", "contact_conditioning"], "properties": {"model_input_contract": {"const": "loitering_impact_state_only@1.0.0"}}}}
  ],
  "$defs": {
    "variable": {"type": "object", "additionalProperties": false, "required": ["name", "path", "distribution"], "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^/"}, "distribution": {"enum": ["uniform", "log_uniform", "integer_uniform", "choice", "unit_sphere_direction", "sphere_shell", "sphere_volume", "haar_quaternion"]}, "low": {"type": "number"}, "high": {"type": "number"}, "values": {"type": "array", "minItems": 1}, "center": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3}, "radius": {"type": "number", "exclusiveMinimum": 0}, "radius_min": {"type": "number", "minimum": 0}, "radius_max": {"type": "number", "exclusiveMinimum": 0}}, "allOf": [{"if": {"properties": {"distribution": {"enum": ["uniform", "log_uniform", "integer_uniform"]}}, "required": ["distribution"]}, "then": {"required": ["low", "high"]}}, {"if": {"properties": {"distribution": {"const": "choice"}}, "required": ["distribution"]}, "then": {"required": ["values"]}}, {"if": {"properties": {"distribution": {"const": "sphere_shell"}}, "required": ["distribution"]}, "then": {"required": ["center", "radius"]}}, {"if": {"properties": {"distribution": {"const": "sphere_volume"}}, "required": ["distribution"]}, "then": {"required": ["center", "radius_min", "radius_max"]}}]},
    "constraint": {"type": "object", "additionalProperties": false, "required": ["kind", "paths", "limit"], "properties": {"kind": {"enum": ["sum_leq", "sum_geq"]}, "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}, "limit": {"type": "number"}}},
    "featureRole": {"type": "object", "additionalProperties": false, "required": ["feature_id", "path", "tensor_feature_names", "role", "availability_stage", "deployment_available"], "properties": {"feature_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^/"}, "tensor_feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "role": {"enum": ["learnable_variable", "fixed_context", "structural_missing", "derived_input"]}, "availability_stage": {"enum": ["raw_input", "prelabel_geometry", "not_applicable"]}, "deployment_available": {"type": "boolean"}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["path", "operator"], "properties": {"path": {"type": "string", "pattern": "^/"}, "operator": {"enum": ["equals", "not_equals", "in", "not_in", "lt", "le", "gt", "ge"]}, "value": {}, "values": {"type": "array", "minItems": 1}}, "allOf": [{"if": {"properties": {"operator": {"enum": ["equals", "not_equals", "lt", "le", "gt", "ge"]}}, "required": ["operator"]}, "then": {"required": ["value"]}}, {"if": {"properties": {"operator": {"enum": ["in", "not_in"]}}, "required": ["operator"]}, "then": {"required": ["values"]}}]},
    "predicateClause": {"type": "object", "additionalProperties": false, "required": ["source", "path", "operator"], "properties": {"source": {"enum": ["case_input", "prelabel_screening"]}, "path": {"type": "string", "pattern": "^/"}, "operator": {"enum": ["equals", "not_equals", "in", "not_in", "lt", "le", "gt", "ge"]}, "value": {}, "values": {"type": "array", "minItems": 1}}, "allOf": [{"if": {"properties": {"operator": {"enum": ["equals", "not_equals", "lt", "le", "gt", "ge"]}}, "required": ["operator"]}, "then": {"required": ["value"]}}, {"if": {"properties": {"operator": {"enum": ["in", "not_in"]}}, "required": ["operator"]}, "then": {"required": ["values"]}}]},
    "jointBlock": {"type": "object", "additionalProperties": false, "required": ["block_id", "kind", "variable_names", "joint_mode"], "properties": {"block_id": {"type": "string", "minLength": 1}, "kind": {"const": "joint"}, "variable_names": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "joint_mode": {"const": "shared_quantile"}}},
    "conditionalBlock": {"type": "object", "additionalProperties": false, "required": ["block_id", "kind", "variable_names", "condition", "inactive_policy"], "properties": {"block_id": {"type": "string", "minLength": 1}, "kind": {"const": "conditional"}, "variable_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "condition": {"$ref": "#/$defs/condition"}, "inactive_policy": {"const": "preserve_base"}}},
    "variableBlock": {"oneOf": [{"$ref": "#/$defs/jointBlock"}, {"$ref": "#/$defs/conditionalBlock"}]},
    "geometryStratum": {"type": "object", "additionalProperties": false, "required": ["stratum_id", "description", "pre_label", "predicate"], "properties": {"stratum_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "pre_label": {"const": true}, "predicate": {"type": "object", "additionalProperties": false, "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicateClause"}}}}}},
    "streamRole": {"type": "object", "additionalProperties": false, "required": ["role", "stream", "split", "train_eligible"], "properties": {"role": {"enum": ["reference_train", "reference_validation", "reference_test", "geometry_stratified_train", "rare_stress_test"]}, "stream": {"enum": ["reference", "geometry_stratified", "stress"]}, "split": {"enum": ["train", "validation", "test"]}, "train_eligible": {"type": "boolean"}}},
    "roundAllocation": {"type": "object", "additionalProperties": false, "required": ["role", "stratum_id", "proposal_id", "count"], "properties": {"role": {"enum": ["reference_train", "reference_validation", "reference_test", "geometry_stratified_train", "rare_stress_test"]}, "stratum_id": {"type": "string", "minLength": 1}, "proposal_id": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 1}}},
    "roundBudget": {"type": "object", "additionalProperties": false, "required": ["round", "allocations"], "properties": {"round": {"type": "integer", "minimum": 0}, "allocations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/roundAllocation"}}}},
    "replicateOverride": {"type": "object", "additionalProperties": false, "required": ["role", "replicates"], "properties": {"role": {"enum": ["reference_train", "reference_validation", "reference_test", "geometry_stratified_train", "rare_stress_test"]}, "stratum_id": {"type": "string", "minLength": 1}, "replicates": {"type": "integer", "minimum": 2}}},
    "replicatePolicy": {"type": "object", "additionalProperties": false, "required": ["default_replicates", "outcome_adaptive", "overrides"], "properties": {"default_replicates": {"type": "integer", "minimum": 2}, "outcome_adaptive": {"const": false}, "overrides": {"type": "array", "items": {"$ref": "#/$defs/replicateOverride"}}}},
    "keyProjection": {"type": "object", "additionalProperties": false, "required": ["projection_id", "paths", "purpose", "pre_label_only"], "properties": {"projection_id": {"type": "string", "minLength": 1}, "paths": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}, "purpose": {"enum": ["coverage_audit", "stratification", "diagnostic"]}, "pre_label_only": {"const": true}}},
    "proxyScope": {"type": "object", "additionalProperties": false, "required": ["scope", "geometry_boundary", "target_identity_policy", "deployment_features_match_training", "evidence_status"], "properties": {"scope": {"enum": ["fixed_target", "multi_target"]}, "geometry_boundary": {"enum": ["solver_proxy", "end_to_end"]}, "target_identity_policy": {"enum": ["fixed_target_hash", "target_family_registry"]}, "deployment_features_match_training": {"const": true}, "evidence_status": {"enum": ["unverified", "provisional", "validated"]}}},
    "legalSampling": {"type": "object", "additionalProperties": false, "required": ["invalid_candidate_policy", "max_attempts_per_allocation"], "properties": {"invalid_candidate_policy": {"enum": ["fail_closed", "reject_and_resample"]}, "max_attempts_per_allocation": {"type": "integer", "minimum": 1, "maximum": 1000000}}},
    "selectionDeclaration": {"type": "object", "additionalProperties": false, "required": ["schema_version", "selection_rule_id", "selection_stage", "outcome_blind", "dependency_paths"], "properties": {"schema_version": {"const": "1.0.0"}, "selection_rule_id": {"type": "string", "minLength": 1}, "selection_stage": {"const": "pre_outcome"}, "outcome_blind": {"const": true}, "dependency_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/.+"}}}},
    "contactConditioning": {"type": "object", "additionalProperties": false, "required": ["contract_id", "mode", "estimand", "selection_declaration"], "properties": {"contract_id": {"const": "s-contact-first-armor@1.0.0"}, "contract_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "mode": {"const": "contact_conditioned_first_armor"}, "estimand": {"const": "criterion_exceedance_probability_given_first_armor_contact"}, "selection_declaration": {"$ref": "#/$defs/selectionDeclaration"}, "selection_declaration_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
  }
}
